# Copy this file to backend/.env and fill in real values.
# .env is gitignored — never commit real API keys.

# ----------------------------------------------------------
# OpenRouter (used by Analysis + Text Chat always, and by Voice Chat
# only when VAPI_LLM_PROVIDER=custom-llm). A free hosted model, so no
# local LLM server/hardware is required. Get a key at
# https://openrouter.ai/keys (no card required) and pick a currently-
# free model from https://openrouter.ai/models?max_price=0 — the free
# catalog rotates over time, so swap OPENROUTER_MODEL if it starts
# failing with "unavailable for free".
# ----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free

# ----------------------------------------------------------
# WhatsApp chat import (POST /api/analyze/whatsapp/upload). Oversized
# uploads are rejected with HTTP 413 before being read into memory.
# ----------------------------------------------------------
MAX_WHATSAPP_UPLOAD_SIZE_MB=15

# ----------------------------------------------------------
# MongoDB — stores every profile, personality analysis, and chat/voice
# conversation history. Replaces the old backend/profiles/ flat-file
# storage. Get a free connection string from https://www.mongodb.com/atlas
# (create a cluster -> Connect -> Drivers -> copy the connection string),
# or point at a local MongoDB instance instead
# (mongodb://localhost:27017).
# ----------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=reflectai

# ----------------------------------------------------------
# Authentication — required. Signs the session cookie every logged-in
# request carries. Generate any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
JWT_SECRET=
JWT_EXPIRE_DAYS=14

# The Vite dev server's origin — must match exactly (scheme + host + port)
# or the browser will refuse to send/receive the session cookie.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true once this backend is served over https in production —
# browsers reject a Secure cookie sent over plain http.
COOKIE_SECURE=false

# Optional: enables the "Sign in with Google" button. Create an OAuth 2.0
# Client ID (Web application) at https://console.cloud.google.com/apis/credentials,
# add http://localhost:5173 as an Authorized JavaScript origin, then set the
# same Client ID here and as VITE_GOOGLE_CLIENT_ID in frontend/.env. Leave
# blank to disable Google Sign-In — email/password auth needs no setup.
GOOGLE_CLIENT_ID=

# Rate limiting (in-memory, per server-observed client IP). Defaults are
# a standard, generous-for-real-users baseline — most deployments won't
# need to change these.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_OTP_REQUEST_MAX_ATTEMPTS=5
AUTH_OTP_REQUEST_WINDOW_SECONDS=900

# ----------------------------------------------------------
# Email (signup OTP verification) — required for signup to work; existing
# users can still log in without it. Sends the "enter this code" email via
# Gmail SMTP with an App Password:
#   1. Turn on 2-Step Verification on the Gmail account you want to send
#      from: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" / "Other", any name) — a 16-character code, not your
#      normal Gmail password.
#   3. SMTP_USERNAME is that Gmail address, SMTP_PASSWORD is the App
#      Password (spaces are fine either way).
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ReflectAI

OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ----------------------------------------------------------
# Public URL for THIS backend, required for Voice Chat (both modes).
# Vapi is a cloud service and cannot reach "localhost" — it needs a
# public HTTPS URL to send webhooks back to this server (call started/
# ended, and the transcript used to sync a voice conversation into
# shared memory with Text Chat). custom-llm mode also uses this URL for
# its per-turn callback.
#
# For local development, expose your backend with a tunnel, e.g.:
#   ngrok http 8000
# then copy the https://*.ngrok-free.app URL it prints below.
# ----------------------------------------------------------
PUBLIC_BACKEND_URL=

# ----------------------------------------------------------
# Vapi (https://vapi.ai) — Voice Chat
# ----------------------------------------------------------

# Server-side secret key (Vapi dashboard -> API Keys -> Private Key).
# Only needed if you pre-register assistants or fetch call data via the
# server REST API. Optional for the default fully-dynamic setup.
VAPI_PRIVATE_KEY=

# Public key (Vapi dashboard -> API Keys -> Public Key). Required to
# open a call from the browser. Also set as VITE_VAPI_PUBLIC_KEY in
# frontend/.env — same value, two places because the browser bundle and
# this server are separate processes.
VAPI_PUBLIC_KEY=

# Shared secret. The backend attaches this as a custom header
# (x-reflectai-secret) on the assistant's server/model config and
# verifies it on every webhook + custom-llm request, so it's set
# entirely from this .env — nothing to configure in the Vapi dashboard.
# Generate any random string. Leave blank during local testing (checks
# are skipped when empty), but set one before this tunnel URL is shared
# or long-lived.
VAPI_SERVER_SECRET=

# Optional: reuse a pre-created Vapi Assistant (dashboard) as a template.
# Leave blank to let the backend build a fully inline assistant config
# per call — no dashboard setup required.
VAPI_ASSISTANT_ID=

# Text-to-speech voice.
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# Speech-to-text.
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2
VAPI_TRANSCRIBER_LANGUAGE=en

# Which LLM generates voice replies. Both modes build their prompt from
# the same analyzed profile — only the execution engine differs.
#
# "vapi-native" (default, recommended): Vapi's own hosted model
#   generates replies in real time. REQUIRES a model credential added in
#   your Vapi dashboard under Provider Credentials — without one, calls
#   will fail to get a model response. This is a one-time setup step on
#   Vapi's side, not something this .env controls.
#
#   Free/cheap providers Vapi supports the same way:
#     openrouter (default here) — openrouter.ai, no cost for models with
#            a ":free" model ID suffix. The free catalog rotates over
#            time (a previous default here got retired mid-project) —
#            if VAPI_NATIVE_MODEL starts failing with "unavailable for
#            free", check https://openrouter.ai/models?max_price=0 for a
#            current one and swap it in.
#     google — Google AI Studio, free tier, no credit card in most
#            regions. model examples: gemini-2.0-flash, gemini-1.5-flash
#     openai — not free, but cheap. model: gpt-4o-mini
#
# "custom-llm": every voice reply is generated by this backend's own
#   OpenRouter call instead (same OPENROUTER_API_KEY/OPENROUTER_MODEL
#   above). No Vapi-side credential needed, and it shares memory/logic
#   with Text Chat — but round-tripping through this backend adds
#   latency on top of OpenRouter's own free-tier response time, which
#   can feel less snappy than vapi-native for a live call.
VAPI_LLM_PROVIDER=vapi-native
VAPI_NATIVE_MODEL_PROVIDER=openrouter
VAPI_NATIVE_MODEL=google/gemma-4-26b-a4b-it:free

# --- custom-llm mode only (ignored when VAPI_LLM_PROVIDER=vapi-native) ---

# How long Vapi will wait for a first token from custom-llm before
# giving up on that turn. Vapi's own default is 20s — generous headroom
# in case OpenRouter's free tier is slow to respond.
VAPI_CUSTOM_LLM_TIMEOUT_SECONDS=120

# How long the whole CALL can sit with no audio before Vapi hangs up
# (endedReason "silence-timed-out"). Vapi's platform default (~30s) is
# shorter than the custom-llm timeout above, so a slow reply can get
# discarded because the call already ended. Keep this above
# VAPI_CUSTOM_LLM_TIMEOUT_SECONDS.
VAPI_SILENCE_TIMEOUT_SECONDS=180

VOICE_MAX_TOKENS=60
VOICE_TEMPERATURE=0.6
