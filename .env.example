# Read by `docker compose` itself (not by the app) to fill in the
# ${VAR} placeholders in docker-compose.yml at build time. Copy this
# file to `.env` in the repo root and fill in the same values you put
# in frontend/.env for local dev.
#
# These end up baked into the public frontend JS bundle — that's normal
# for a Vapi public key and a Google OAuth client ID (both are
# client-side-safe by design), not a leak.

VITE_VAPI_PUBLIC_KEY=
VITE_GOOGLE_CLIENT_ID=
